# Servidor IronTrack (server.ts)
PORT=8443
# Pasta onde os JSONs de dados são gravados (padrão: ./data)
DATA_DIR="./data"
# Login do administrador (usado quando data/admin.json não existe).
# No Vercel, ADMIN_PASSWORD é obrigatório: sem ele o login de admin fica desativado.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="1234"

# --- Vercel ---
# No Vercel os dados ficam no Vercel Blob (Storage > Blob > conectar ao projeto).
# O Vercel cria esta variável sozinho ao conectar o Blob Store; localmente, deixe vazia
# para gravar em ./data. Preencha só se quiser usar o Blob também no seu PC.
BLOB_READ_WRITE_TOKEN=""
# "private" (padrão, recomendado) ou "public", conforme o tipo do Blob Store criado
BLOB_ACCESS="private"
